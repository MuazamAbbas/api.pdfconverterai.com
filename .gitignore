# Virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode / cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment / secrets - never commit
.env
.env.*
!.env.example

# Application logs (rotated separately, not source-controlled). Anchored to
# repo root - matches the same unanchored-pattern risk fixed for models/
# below; confirmed via `find`/`git check-ignore` that no nested logs/ dir
# exists anywhere in the tree today, so this is preventive, not a recovery.
/logs/
*.log

# Build artifacts. Anchored to repo root for the same reason as /logs/ above -
# confirmed no nested build/ or dist/ dir exists anywhere in the tree today.
/build/
/dist/
*.egg-info/

# Downloaded/cached ML model weights (large binary data, not source code).
# Anchored to repo root (settings.model_path points at "<repo-root>/models") -
# unanchored "models/" previously also matched app/models/ (Pydantic schemas,
# source code) anywhere in the tree, silently excluding it from git.
/models/

# ACME challenge files (ephemeral, regenerated by CloudPanel/Let's Encrypt)
.well-known/

# OS/editor cruft
.DS_Store
